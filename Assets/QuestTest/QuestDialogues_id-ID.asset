  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: QuestDialogues_id-ID
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: id-ID
  m_SharedData: {fileID: 11400000, guid: b63b0fb0e91f6f84291e5fd4603c7f0f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 49361555456
    m_Localized: '*huft huft*, Tolong cepat beri saya <b> sesuatu untuk menetralkan
      penyebaran racun<b>, saya telah digigit ular berbisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 9867824566272
    m_Localized: '"Astaga, pagi ini aku terbangun dengan kulit semerah tomat dan
      gatal luar biasa. Tolong beri aku racikan untuk meredakannya, cepat!"'
    m_Metadata:
      m_Items: []
  - m_Id: 10587302891520
    m_Localized: '"Tanganku tergores ranting tajam saat membelah kayu bakar. Aku
      butuh salep atau ramuan untuk mempercepat penyembuhannya."'
    m_Metadata:
      m_Items: []
  - m_Id: 10712880353280
    m_Localized: '"Sial, gigiku nyut-nyutan! Bibiku memasak daging babi hutan keras
      seperti sol sepatu. Aku butuh penawar untuk meredakan siksaan di gigiku ini."'
    m_Metadata:
      m_Items: []
  - m_Id: 11072902631424
    m_Localized: '"Musim dingin akan tiba, dan aku harus berburu monster buas untuk
      persediaan makan keluargaku. Beri aku ramuan kekuatan, sesuatu yang bisa membuat
      senjataku menghabisi mangsa dengan mudah."'
    m_Metadata:
      m_Items: []
  - m_Id: 11321968791552
    m_Localized: '"Menunggangi kuda keras kepala itu benar-benar menyiksa punggungku.
      Berikan racikan terbaikmu untuk nyeri punggung, aku sangat membutuhkannya."'
    m_Metadata:
      m_Items: []
  - m_Id: 11409222897664
    m_Localized: '"Srot... Astaga, aku sudah tidak tahan! Hidung kiriku mengalir
      seperti sungai, dan yang kanan sekering gurun. Tolong beri aku obat flu."'
    m_Metadata:
      m_Items: []
  - m_Id: 11516395753472
    m_Localized: '"Uhuk, uhuk! Tuan Alkemis, kumohon beri aku obat batuk. Batuk sialan
      ini benar-benar menghambat pekerjaanku di ladang."'
    m_Metadata:
      m_Items: []
  - m_Id: 11620640985088
    m_Localized: '"Kudengar kabar pasukan musuh akan segera menyerang. Tubuhku tidak
      cukup kuat menahan tebasan pedang. Aku butuh ramuan untuk memperkuat pertahanan
      tubuhku."'
    m_Metadata:
      m_Items: []
  - m_Id: 11783178653696
    m_Localized: '"Anakku demam tinggi! Aku sudah memberinya ramuan kuno ibuku, tapi
      tidak mempan. Kumohon, aku butuh obat untuk menurunkan panas badannya."'
    m_Metadata:
      m_Items: []
  - m_Id: 11927693398016
    m_Localized: '"Karena pesanan serikat menumpuk, aku nyaris tidak makan seminggu
      ini. Perutku kembung, mual, dan rasanya ingin muntah. Beri aku obat untuk meredakan
      lambungku ini."'
    m_Metadata:
      m_Items: []
  - m_Id: 12090071683072
    m_Localized: '"Sepertinya aku terlalu memaksakan diri mencari rumput untuk kudaku
      semalam. Sekarang kepalaku berdenyut seperti dipalu pandai besi. Punya penawarnya?"'
    m_Metadata:
      m_Items: []
  - m_Id: 12282669928448
    m_Localized: '"Aku kehabisan napas setelah berpatroli tiga putaran mengelilingi
      tembok kota, dan masih ada empat putaran lagi sebelum senja! Tolong buatkan
      ramuan untuk memulihkan staminaku."'
    m_Metadata:
      m_Items: []
  - m_Id: 12551902302208
    m_Localized: '"Ketua serikat terus menambah pekerjaanku! Aku butuh sesuatu untuk
      mempercepat gerak tanganku. Tolong buatkan aku satu ramuan kelincahan."'
    m_Metadata:
      m_Items: []
  - m_Id: 12660882903040
    m_Localized: '"Prajurit kerajaan menyuruhku memindahkan lima gerobak kayu raksasa!
      Tulangku bisa remuk! Aku butuh ramuan kekuatan fisik untuk mengangkat kayu-kayu
      sialan itu."'
    m_Metadata:
      m_Items: []
  - m_Id: 12771276984320
    m_Localized: '"Belakangan ini aku gemar menyelam mencari mutiara di danau belakang
      desa. Aku butuh racikan ajaib agar bisa menahan napas lebih lama di bawah air,
      supaya aku bisa menjelajah lebih jauh."'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
